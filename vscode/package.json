{
  "name": "rosegoldc",
  "displayName": "RoseGoldC",
  "description": "Language support for RoseGoldC: highlighting, diagnostics, outline, CodeLens, completion, hover, signature help, find references, go to definition, highlight, rename, code actions, run, and tests",
  "version": "0.0.4",
  "publisher": "rosegoldc",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "rosegold",
    "rosegoldc",
    "rg"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.rg"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rosegold",
        "aliases": [
          "RoseGold",
          "rosegold"
        ],
        "extensions": [
          ".rg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rosegold-light.svg",
          "dark": "./icons/rosegold.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rosegold",
        "scopeName": "source.rosegold",
        "path": "./syntaxes/rosegold.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rosegold",
        "path": "./snippets/rosegold.json"
      }
    ],
    "commands": [
      {
        "command": "rosegoldc.runFile",
        "title": "RoseGoldC: Run File",
        "icon": "$(play)"
      },
      {
        "command": "rosegoldc.testFile",
        "title": "RoseGoldC: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "rosegoldc.recheck",
        "title": "RoseGoldC: Recheck File",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "rosegoldc.runFile",
          "when": "resourceLangId == rosegold",
          "group": "navigation@1"
        },
        {
          "command": "rosegoldc.testFile",
          "when": "resourceLangId == rosegold",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "rosegoldc.runFile",
          "when": "resourceLangId == rosegold",
          "group": "rosegoldc@1"
        },
        {
          "command": "rosegoldc.testFile",
          "when": "resourceLangId == rosegold",
          "group": "rosegoldc@2"
        }
      ],
      "commandPalette": [
        {
          "command": "rosegoldc.runFile",
          "when": "resourceLangId == rosegold"
        },
        {
          "command": "rosegoldc.testFile",
          "when": "resourceLangId == rosegold"
        },
        {
          "command": "rosegoldc.recheck",
          "when": "resourceLangId == rosegold"
        }
      ]
    },
    "configuration": {
      "title": "RoseGoldC",
      "properties": {
        "rosegoldc.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to RoseGoldC.exe. Empty = build/RoseGoldC.exe in the workspace, then PATH."
        },
        "rosegoldc.diagnosticsDelayMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "description": "How long to wait after you stop typing before re-checking."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "rosegoldc",
        "label": "RoseGoldC",
        "owner": "rosegoldc",
        "source": "rosegoldc",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "rosegoldc-located",
        "label": "RoseGoldC located",
        "owner": "rosegoldc",
        "source": "rosegoldc",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(?:parse error|type error|load error|constexpr error|runtime error) in (.*) at (\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "punctuation.definition.decorator.rosegold",
              "keyword.control.directive.rosegold",
              "entity.name.function.decorator.rosegold"
            ],
            "settings": {
              "foreground": "#E8A0BF",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "storage.type.rosegold",
            "settings": {
              "foreground": "#F0B27A"
            }
          },
          {
            "scope": "keyword.control.rosegold",
            "settings": {
              "foreground": "#C4B5FD"
            }
          },
          {
            "scope": "entity.name.function.rosegold",
            "settings": {
              "foreground": "#F5D0A9"
            }
          }
        ]
      }
    }
  }
}
