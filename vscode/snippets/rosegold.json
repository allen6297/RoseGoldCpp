{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}): ${3:Int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Function declaration"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fn main(): ${1:Int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Entry point fn main"
  },
  "Test": {
    "prefix": "@test",
    "body": [
      "@test",
      "fn ${1:test_name}() {",
      "\t$0",
      "}"
    ],
    "description": "@test function"
  },
  "Deprecated": {
    "prefix": "@deprecated",
    "body": [
      "@deprecated",
      "fn ${1:name}(${2:args}): ${3:Int} {",
      "\t$0",
      "}"
    ],
    "description": "Deprecated function"
  },
  "Constexpr": {
    "prefix": "@constexpr",
    "body": [
      "@constexpr",
      "fn ${1:name}(${2:args}): ${3:Int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Pure constexpr function"
  },
  "Ufcs": {
    "prefix": "@ufcs",
    "body": [
      "@ufcs",
      "fn ${1:name}(${2:args}): ${3:Int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "UFCS: x.fn(args) means fn(x, args)"
  },
  "OptionalField": {
    "prefix": "@optional",
    "body": [
      "@optional",
      "${1:x}: ${2:Int};"
    ],
    "description": "Optional struct/class field"
  },
  "Doc": {
    "prefix": "///",
    "body": [
      "/// ${1:description}"
    ],
    "description": "Doc comment"
  },
  "Block comment": {
    "prefix": "/#",
    "body": [
      "/# ${1:comment} #/"
    ],
    "description": "Block comment"
  },
  "Signal": {
    "prefix": "signal",
    "body": [
      "signal ${1:name}(${2:args});"
    ],
    "description": "Declare a signal"
  },
  "Connect": {
    "prefix": "connect",
    "body": [
      "${1:name}.connect(${2:handler});"
    ],
    "description": "Subscribe a function to a signal"
  },
  "Emit": {
    "prefix": "emit",
    "body": [
      "${1:name}.emit(${0});"
    ],
    "description": "Fire a signal now"
  },
  "Emit deferred": {
    "prefix": "emit_deferred",
    "body": [
      "${1:name}.emit_deferred(${0});"
    ],
    "description": "Fire a signal after the current function returns"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "fn (${1:args}): ${2:Int} {",
      "\t$0",
      "}"
    ],
    "description": "Anonymous function"
  },
  "Disconnect": {
    "prefix": "disconnect",
    "body": [
      "${1:name}.disconnect(${2:handler});"
    ],
    "description": "Unsubscribe a function from a signal"
  },
  "Var": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:0};"
    ],
    "description": "Variable binding"
  },
  "Const": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${2:value};"
    ],
    "description": "Constant binding (init-once)"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Struct declaration"
  },
  "Generic struct": {
    "prefix": "structT",
    "body": [
      "struct ${1:Name}[${2:T}] {",
      "\t${3:value}: ${2:T};",
      "\t$0",
      "}"
    ],
    "description": "Generic struct"
  },
  "Generic function": {
    "prefix": "fnT",
    "body": [
      "fn ${1:name}[${2:T}](${3:x}: ${2:T}): ${2:T} {",
      "\t$0",
      "}"
    ],
    "description": "Generic function"
  },
  "Data": {
    "prefix": "data",
    "body": [
      "data ${1:Name} {",
      "\t${2:field}: ${3:Int};",
      "\t$0",
      "}"
    ],
    "description": "Data type (frozen fields)"
  },
  "Data impl": {
    "prefix": "dataimpl",
    "body": [
      "data ${1:Name} impl ${2:Trait} {",
      "\t${3:field}: ${4:Int};",
      "\tfn ${5:name}(): ${6:Int} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Data type that implements a trait"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tvar ${2:field}: ${3:Int} = ${4:0};",
      "\tfn ${5:name}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Class declaration"
  },
  "Abstract class": {
    "prefix": "abstract",
    "body": [
      "abstract class ${1:Name} {",
      "\tabstract fn ${2:name}(): ${3:String};",
      "\t$0",
      "}"
    ],
    "description": "Abstract class (cannot construct)"
  },
  "Final class": {
    "prefix": "final",
    "body": [
      "final class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Final class (cannot extend)"
  },
  "Private method": {
    "prefix": "private",
    "body": [
      "private fn ${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "Private method (this type only)"
  },
  "Protected method": {
    "prefix": "protected",
    "body": [
      "protected fn ${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "Protected method (this class and subclasses)"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant},",
      "\t$0",
      "}"
    ],
    "description": "Enum declaration"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern} { $0 }",
      "\t_ { }",
      "}"
    ],
    "description": "Match statement"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:n} {",
      "\t${2:1} { $0 }",
      "\t_ { }",
      "}"
    ],
    "description": "Switch statement (same as match)"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfn ${2:name}(): ${3:Int};",
      "}"
    ],
    "description": "Trait declaration (signatures only)"
  },
  "Generic trait": {
    "prefix": "traitT",
    "body": [
      "trait ${1:Name}[${2:T}] {",
      "\tfn ${3:name}(self): ${2:T};",
      "}"
    ],
    "description": "Generic trait"
  },
  "Impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Name} {",
      "\tfn ${2:name}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Impl block for type methods"
  },
  "Generic impl": {
    "prefix": "implT",
    "body": [
      "impl[${1:T}] ${2:Trait}[${1:T}] for ${3:Type}[${1:T}] {",
      "\tfn ${4:name}(self): ${1:T} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Generic impl Trait for Type"
  },
  "Impl trait for": {
    "prefix": "implfor",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\tfn ${3:name}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implement a trait for a type"
  },
  "Method": {
    "prefix": "method",
    "body": [
      "fn ${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "Struct method"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:name};"
    ],
    "description": "Import module"
  },
  "Import std": {
    "prefix": "importstd",
    "body": [
      "import std;"
    ],
    "description": "Import std (std.math, std.str, std.io, std.vec, std.time, std.path, std.json, std.regex, std.ui)"
  },
  "Import std.math": {
    "prefix": "importstdmath",
    "body": [
      "import std.math;"
    ],
    "description": "Import std.math (binds std and math)"
  },
  "Import std.time": {
    "prefix": "importstdtime",
    "body": [
      "import std.time;"
    ],
    "description": "Import std.time (now, sleep)"
  },
  "Import std.path": {
    "prefix": "importstdpath",
    "body": [
      "import std.path;"
    ],
    "description": "Import std.path (join, parent, stem)"
  },
  "Import std.json": {
    "prefix": "importstdjson",
    "body": [
      "import std.json;"
    ],
    "description": "Import std.json (parse, stringify, valid)"
  },
  "Import std.regex": {
    "prefix": "importstdregex",
    "body": [
      "import std.regex;"
    ],
    "description": "Import std.regex (is_match, find, findall, replace, split)"
  },
  "Import ui": {
    "prefix": "importui",
    "body": [
      "import ui;",
      "",
      "fn main(): Int {",
      "    var w = try ui.open(\"${1:RoseGold}\", ${2:400}, ${3:240});",
      "    var go = Button { text: \"${5:Close}\" };",
      "    go.clicked.connect(fn () { w.close(); });",
      "    w.add(VStack {",
      "        spacing: 12,",
      "        children: [",
      "            Label { text: \"${4:Hello}\" }.padding(8),",
      "            go",
      "        ]",
      "    }.padding(12));",
      "    w.run();",
      "    return 0;",
      "}"
    ],
    "description": "Open a window with a nested VStack"
  },
  "From import": {
    "prefix": "from",
    "body": [
      "from ${1:module} import ${2:name};"
    ],
    "description": "From-import a name"
  },
  "From std": {
    "prefix": "fromstd",
    "body": [
      "from std import ${1:UUID};"
    ],
    "description": "From-import a std name (UUID, math, …)"
  },
  "UUID v4": {
    "prefix": "uuid",
    "body": [
      "var ${1:id} = std.v4();"
    ],
    "description": "Random UUID v4"
  },
  "Mod": {
    "prefix": "mod",
    "body": [
      "mod ${1:name} {",
      "\tpub fn ${2:name}($3): ${4:Int} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Module block"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "If block"
  },
  "If else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:xs} {",
      "\t$0",
      "}"
    ],
    "description": "For-in loop"
  },
  "DoCatch": {
    "prefix": "do",
    "body": [
      "do {",
      "\ttry ${1:boom}();",
      "} catch ${2:e} {",
      "\t$0",
      "}"
    ],
    "description": "do / catch"
  },
  "ThrowsFn": {
    "prefix": "throws",
    "body": [
      "fn ${1:name}(${2:args}) throws: ${3:String} {",
      "\tthrow ${4:\"error\"};",
      "}"
    ],
    "description": "Throwing function"
  },
  "Try": {
    "prefix": "try",
    "body": [
      "try ${1:boom}()"
    ],
    "description": "try call"
  },
  "For range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "For-in exclusive range"
  },
  "Array": {
    "prefix": "arr",
    "body": [
      "var ${1:xs} = [${2:1, 2, 3}];"
    ],
    "description": "Array literal"
  },
  "Map": {
    "prefix": "map",
    "body": [
      "var ${1:m} = {\"${2:key}\": ${3:1}};"
    ],
    "description": "Map literal"
  },
  "Pass": {
    "prefix": "pass",
    "body": [
      "pass;"
    ],
    "description": "No-op statement"
  },
  "Async function": {
    "prefix": "async",
    "body": [
      "async fn ${1:name}(${2:args}): ${3:Int} {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Async function (returns Future)"
  },
  "Async main": {
    "prefix": "asyncmain",
    "body": [
      "async fn main(): Int {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "Async entry point"
  },
  "Await": {
    "prefix": "await",
    "body": [
      "await ${1:future}"
    ],
    "description": "Await a Future"
  },
  "Future.all": {
    "prefix": "futureall",
    "body": [
      "await Future.all([${1:a}, ${2:b}])"
    ],
    "description": "Await all Futures"
  },
  "Future.race": {
    "prefix": "futurerace",
    "body": [
      "await Future.race([${1:a}, ${2:b}])"
    ],
    "description": "Race Futures; first to finish wins"
  },
  "Time delay": {
    "prefix": "delay",
    "body": [
      "await time.delay(${1:100});"
    ],
    "description": "Await std.time.delay (ms)"
  },
  "UI async frame": {
    "prefix": "uiframe",
    "body": [
      "import ui;",
      "",
      "async fn main(): Int {",
      "\tvar w = try ui.open(\"${1:App}\", ${2:400}, ${3:240});",
      "\twhile await w.next_frame() {",
      "\t\t$0",
      "\t}",
      "\tw.close();",
      "\treturn 0;",
      "}"
    ],
    "description": "Async UI window with next_frame loop"
  },
  "UI button": {
    "prefix": "uibutton",
    "body": [
      "var ${1:btn} = Button { text: \"${2:OK}\" };",
      "${1:btn}.clicked.connect(fn () {",
      "\t$0",
      "});"
    ],
    "description": "UI Button with click handler"
  },
  "UI label": {
    "prefix": "uilabel",
    "body": [
      "Label { text: \"${1:Hello}\" }"
    ],
    "description": "UI Label widget"
  },
  "UI VStack": {
    "prefix": "uivstack",
    "body": [
      "VStack {",
      "\tspacing: ${1:12},",
      "\tchildren: [",
      "\t\t$0",
      "\t]",
      "}"
    ],
    "description": "UI vertical stack"
  }
}
